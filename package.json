{
  "name": "deskfolk",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny animated desktop companion with a real-time 3D character",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/build-codex-launcher.cjs && electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "local.liquidglass.pet",
    "productName": "Deskfolk",
    "artifactName": "Deskfolk-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/icons/tray*.png",
      "assets/icons/deskfolk.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".cache/codex-launcher/DeskfolkCodexLauncher.exe",
        "to": "launcher/DeskfolkCodexLauncher.exe"
      },
      {
        "from": "plugins/deskfolk-deepseek-harness",
        "to": "plugins/deskfolk-deepseek-harness",
        "filter": ["package.json", "plugin.mjs", "bridge-client.mjs", "cordis.patch.yml", "setup.mjs", "README.md"]
      },
      {
        "from": "plugins/deskfolk-claude-code",
        "to": "plugins/deskfolk-claude-code",
        "filter": ["setup.mjs", "hook.mjs", "statusline.mjs", "bridge-client.mjs", "README.md"]
      }
    ],
    "win": {
      "icon": "assets/icons/deskfolk.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "scripts/installer-startup.nsh",
      "installerIcon": "assets/icons/deskfolk.ico",
      "uninstallerIcon": "assets/icons/deskfolk.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "three": "^0.183.2"
  }
}
