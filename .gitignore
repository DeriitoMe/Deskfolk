# Explicit project roots keep accidental Electron profiles and local artifacts
# out of a newly initialized repository. Add new public roots deliberately.
/*
!/.gitignore
!/README.md
!/package.json
!/package-lock.json
!/electron.vite.config.ts
!/review.vite.config.ts
!/tsconfig.json
!/assets/
!/bridge/
!/docs/
!/electron/
!/renderer/
!/scripts/
!/shared/
!/plugins/

# Dependencies, builds, test profiles, local rollback copies, and credentials.
**/node_modules/
**/out/
**/release/
**/dist/
**/.cache/
**/.qa*/
**/*user-data*/
**/.env
**/.env.*
!**/.env.example
**/.npmrc
**/bridge.json
**/history.json
**/activity.json
**/preferences.json
**/Cookies
**/Login Data
**/Local State
**/*.log
**/*.pem
**/*.key
**/*.blend1
**/*.kra~
**/.DS_Store

# Historical live verification may contain session IDs, local locations, or
# source-app metadata. The sanitized export is the reviewed upload boundary.
assets/**/verification/
assets/**/preview/*.json
assets/characters/wakaba-mutsumi/v41-3d/preview/
assets/**/ROLLBACK.txt
assets/**/GENERATION_PROMPTS.json
assets/**/metrics.md

# Editable originals can carry packed absolute paths. Upload the reviewed portable
# copies from the prepared public-source snapshot instead of these local originals.
assets/**/source/*
!assets/characters/wakaba-mutsumi/v42-motion/source/art/

# Keep active, reviewed build/test tools; archived machine-specific helpers stay
# available locally. New helpers need an explicit entry before publication.
scripts/*
!scripts/setup-codex.ps1
!scripts/privacy-*.py
!scripts/prepare-public-source.py
!scripts/stage-v42-package.mjs
!scripts/verify-v42-package.mjs
!scripts/qa-v42-*
!scripts/build-v42-*.py
!scripts/assemble-v42-*.lua
!scripts/export-v42-*.cjs
!scripts/prepare-v42-*.py
!scripts/prepare-head-icon.lua
!scripts/build-codex-launcher.cjs
!scripts/CodexLauncher.cs
!scripts/installer-startup.nsh
!scripts/build-celebration-*
!scripts/assemble-celebration-*
!scripts/export-celebration-effects-krita.py
!scripts/verify-celebration-art.py
!scripts/build-morning-paper.py
!scripts/qa-read-paper.cjs
!scripts/qa-morning-brief.cjs
!scripts/build-mutsumi-guitar.py
!scripts/qa-guitar.cjs
!scripts/prepare-guitar-solo-audio.py
!scripts/qa-guitar-egg.cjs
!scripts/qa-language.cjs

